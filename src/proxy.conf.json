{
  "/api": {
    "target": "https://app.linkedscholar.io", 
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": {
      "^/api" : "/api/basic-api"
    },
    "headers": {
      "x-api-key": "YOUR_SECRET_API_KEY"
    }
  },
  "/funding-api": {
    "target": "https://app.linkedscholar.io",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/funding-api" : "/api/funding-api"
    },
    "logLevel": "debug",
    "headers": {
      "x-api-key": "YOUR_SECRET_API_KEY"
    }
  }
}
